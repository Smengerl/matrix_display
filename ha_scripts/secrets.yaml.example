# Copy this file to secrets.yaml (same folder as matrix-display.yaml, i.e.
# [homeassistant]/config/esphome/secrets.yaml) and fill in your own values.
# secrets.yaml is git-ignored so your credentials are never committed.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Home Assistant API encryption key - generate one with:
#   openssl rand -base64 32
matrix_display_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# OTA update password - any strong string
matrix_display_ota_pw: "REPLACE_WITH_A_STRONG_PASSWORD"

# Fallback hotspot password (min. 8 chars) for the AP shown when WiFi fails
matrix_display_fallback_pw: "REPLACE_WITH_A_STRONG_PASSWORD"
